// wall.material
// OGRE material script for the indoor room walls (brick texture)

material RoverWorld/Wall
{
    technique
    {
        pass
        {
            ambient  0.85 0.85 0.85 1.0
            diffuse  1.0  1.0  1.0  1.0
            specular 0.05 0.05 0.05 1.0 8.0

            texture_unit
            {
                texture ../textures/wall.jpg
                scale 0.25 0.25
            }
        }
    }
}