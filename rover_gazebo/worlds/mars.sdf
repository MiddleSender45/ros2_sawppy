<include>
    <uri> https://fuel.gazebosim.org/1.0/jasmeetsingh/models/Mars Gale Crater Patch 1 </uri>
    <name>mars_gale_crater_patch_1</name>
       <!-- x y z r p y -->
    <pose>0 0 -3.3 0.2 0.01 0.0</pose>
</include>

<include>
    <uri> https://fuel.gazebosim.org/1.0/OpenRobotics/models/Falling Rock 1 </uri>
    <name>rockformation</name>
      <pose>-3 -3 0 0 0 0</pose>
</include>

<include>
    <uri> https://fuel.gazebosim.org/1.0/OpenRobotics/models/Falling Rock 2 </uri>
    <name>rockformation2</name>
    <pose>-1 4 0 3.141593 0 0</pose>
</include>

<include>
    <uri> https://fuel.gazebosim.org/1.0/OpenRobotics/models/Falling Rock 3 </uri>
    <name>rockformation3</name>
    <pose>1 0.5 -0.1 -2.52 -0.33 0</pose>
</include>

<include>
    <uri> https://fuel.gazebosim.org/1.0/OpenRobotics/models/Falling Rock 4 </uri>
    <name>rockformation4</name>
    <pose>2 -0.5 -0.4 1.32 -0.64 -0.60</pose>
</include>

