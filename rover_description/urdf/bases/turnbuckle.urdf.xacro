<robot name="turnbuckle" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find rover_description)/urdf/inertials.xacro"/>
    <xacro:macro name="turnbuckle" params="lat_label reflect use_gazebo:=true">
            <link name="${lat_label}_turnbuckle_link">
                <visual name="${lat_label}_turnbuckle_visual">
                    <origin xyz="0 0 0.035" rpy="${math_pi_over_2} ${math_pi_over_2} 0" />
                    <geometry>
                        <mesh filename="package://rover_description/meshes/bases/turnbuckle.stl"/> 
                    </geometry>
                    <material name="white" />
                </visual>
                <collision name="${lat_label}_turnbuckle_collision">
                    <origin xyz="0 0 0.035" rpy="0 0 0" />
                    <geometry>
                        <cylinder radius="0.0045" length="0.10" />
                    </geometry>
                </collision>
                   <xacro:solid_cylinder_inertial 
                    rpy="0 0 0" xyz="0 0 0"
                    mass="0.25"
                    radius="0.0025" 
                    length="0.07" />
            </link>

            <!-- <xacro:unless value="${use_gazebo}"> -->
                <!-- can't have closed loops in URDF -->
                <joint name="back_${lat_label}_turnbuckle_joint" type="revolute">
                    <origin xyz="0 ${reflect * 0.17} 0" rpy="0 ${math_pi_over_2} 0" /> 
                    <axis xyz="1 0 0" />
                    <limit 
                        lower="${-math_pi}"
                        upper="${math_pi}"
                        effort="100.0"
                        velocity="30.0" />
                    <parent link="diff_brace_link" />
                    <child link="${lat_label}_turnbuckle_link" />
                    <!-- This makes sense for display_rover_description, but not simulation -->
                    <!--
                    <xacro:if value="${lat_label == 'left'}">
                      <mimic joint="right_rocker_joint" multiplier="0.35" offset="0.0"/>
                    </xacro:if>
                    <xacro:if value="${lat_label == 'right'}">
                      <mimic joint="right_rocker_joint" multiplier="-0.35" offset="0.0"/>
                    </xacro:if>
                    -->
                </joint>
    <gazebo>
                <!--
                <joint name="front_${lat_label}_turnbuckle_joint" type="fixed">
                    <pose>0.035 0 0 0 0 0</pose>
                    <parent>${lat_label}_rocker_link</parent>
                    <child>${lat_label}_turnbuckle_link</child>
                </joint>
                -->
            <!-- </xacro:unless> -->
    </gazebo>

    </xacro:macro>
</robot>