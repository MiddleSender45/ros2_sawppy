<robot name="rocker" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="rocker_box_length" value="0.43" />
    <xacro:property name="rocker_box_width" value="0.29" />
    <xacro:property name="rocker_box_depth" value="0.10" />
    <xacro:property name="rocker_box_mass" value="0.25" />
    <xacro:include filename="$(find rover_description)/urdf/inertials.xacro"/>

    <xacro:macro name="rocker" params="parent lat_label reflect use_gazebo:=true">
        <!-- link -->
        <link name="${lat_label}_rocker_link">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <mesh filename="package://rover_description/meshes/bases/${lat_label}_rocker_asm.stl" />
                    <!-- <box size="0.1 0.015 0.015"/> -->
                </geometry>
                <material name="white" />
            </visual>
            <collision>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <!-- <mesh filename="package://rover_description/meshes/bases/${lat_label}_rocker_asm.stl" /> -->
                    <box size="${rocker_box_length} ${rocker_box_width} ${rocker_box_depth}"/>
                </geometry>
            </collision>
            <xacro:solid_cuboid_inertial 
                rpy="0 0 0" xyz="0 0 0"
                mass="${rocker_box_mass}"
                x="${rocker_box_length}" y="${rocker_box_width}" z="${rocker_box_depth}" />
        </link>
        <gazebo reference="${lat_label}_rocker_link">
            <material name="white" />
        </gazebo>
        <!-- should be fixed for gazebo simulation, continuous for actual rover -->
        <joint name="${lat_label}_rocker_joint" type="revolute"> <!-- fixed -->
            <origin rpy="0 0 0" xyz="0.071 ${reflect * 0.155} 0.0118"/>
            <axis xyz="0 1 0" />
            <limit 
                lower="-0.3"
                upper="0.3"
                effort="0.0"
                velocity="0.0" />
            <parent link="${parent}" />
            <child link="${lat_label}_rocker_link" />
            <dynamics damping="0.05" friction="0.0"/>

            <!-- Outside (i.e. RVIZ), you can make the rocker joints mimic the differential bar.  
                 In the Actual rover, this is done by the turnbuckles attached to the differential bar -->
                 <!-- dist between center of rover and top end turnbuckle= 166.5 mm -->
                 <!-- dist between pivot of rocker and other end of turnbuckle = 58 mm -->
            <xacro:if value="${use_gazebo}">
              <xacro:if value="${lat_label == 'left'}">
                <mimic joint="right_rocker_joint" multiplier="-1" offset="0.0"/>
              </xacro:if>
                <!-- <mimic joint="diff_brace_joint" multiplier="-2.87" offset="0.0"/> -->
            </xacro:if>

        </joint>

        <gazebo reference="${lat_label}_rocker_joint">
            <provideFeedback>true</provideFeedback>
            <implicitSpringDamper>true</implicitSpringDamper>
        </gazebo>
    </xacro:macro>
</robot>