<robot name="sensor_asus_xtion" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="sensor_asus_xtion" params="prefix parent *origin ">
    <xacro:property name="math_pi_over_2" value="1.5707963267948966" />

    <!-- Define camera_link with X fwd and Z up per REP-103 -->
    <link name="${prefix}_link">
      <visual>
        <origin rpy="${math_pi_over_2} 0 ${math_pi_over_2}" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://rover_description/meshes/sensors/asus_xtion/asus_xtion_pro_live.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="${math_pi_over_2} 0 ${math_pi_over_2}" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://rover_description/meshes/sensors/asus_xtion/asus_xtion_pro_live.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.01" />
        <origin xyz="0 0 0" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0"
          iyy="0.001" iyz="0.0"
          izz="0.001" />
      </inertial>
    </link>
    <joint name="${prefix}_joint" type="fixed">
      <axis xyz="1 0 0"/>
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}_link"/>
    </joint>

    <!-- Define camera_link_optical with z fwd and y down per REP-105 -->
    <link name="${prefix}_link_optical">
      <inertial>
        <mass value="0.001" />
        <origin xyz="0 0 0" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0"
          iyy="0.001" iyz="0.0"
          izz="0.001" />
      </inertial>
    </link>
    <joint name="${prefix}_frame_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-${math_pi_over_2} 0 -${math_pi_over_2}" />
      <parent link="${prefix}_link" />
      <child link="${prefix}_link_optical" />
    </joint>

    <!-- RGBD camera  -->
    
        <!-- RGBD camera also publishes camera/depth/depth_image/points 
         The point cloud is mis-aligned - see 
         https://github.com/gazebosim/gz-sensors/issues/29#issuecomment-3113732696
         Leaving this comment in case it becomes important later.

         If you look in the commit history, I added a second camera just for 
         points that aligned the point cloud properly (according to rviz2), but 
         collapsed to a single camera when optimizing for performance.
         It was camera_pointcloud_frame.
         -->
    <gazebo reference="${prefix}_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>camera/rgbd</topic>
      <!-- append /camera_info /depth_image /image /points -->
      <camera>
        <horizontal_fov>1.25</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.3</near>
          <far>15</far>
        </clip>
        <depth_camera>
        <clip>
          <near>0.3</near>
          <far>15</far>
        </clip>
        </depth_camera>
        <!-- <optical_frame_id>${prefix}_rgbd_frame</optical_frame_id> -->
        <optical_frame_id>${prefix}_link_optical</optical_frame_id>
      </camera>
    </sensor>
    </gazebo>
  </xacro:macro>
</robot>