<robot name="sensor_asus_xtion" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="sensor_asus_xtion" params="prefix parent *origin ">
    <xacro:property name="math_pi_over_2" value="1.5707963267948966" />

    <joint name="${prefix}_joint" type="fixed">
      <axis xyz="1 0 0"/>
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}_link"/>
    </joint>

    <link name="${prefix}_link">
      <visual>
        <origin rpy="${math_pi_over_2} 0 ${math_pi_over_2}" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://rover_description/meshes/sensors/asus_xtion/asus_xtion_pro_live.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="${math_pi_over_2} 0 ${math_pi_over_2}" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://rover_description/meshes/sensors/asus_xtion/asus_xtion_pro_live.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.01" />
        <origin xyz="0 0 0" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0"
          iyy="0.001" iyz="0.0"
          izz="0.001" />
      </inertial>
    </link>

    <joint name="camera_frame_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-${math_pi_over_2} 0 -${math_pi_over_2}" />
      <parent link="${prefix}_link" />
      <child link="camera_frame" />
    </joint>
    <link name="camera_frame">
      <inertial>
        <mass value="0.001" />
        <origin xyz="0 0 0" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0"
          iyy="0.001" iyz="0.0"
          izz="0.001" />
      </inertial>
    </link>

    <!-- Frame dedicated for point cloud publishing. Based on observation: the
         cloud appears rotated relative to the
         optical frame. Create a child frame with that rotation so the point
         cloud's header frame matches its data axes. -->
    <joint name="camera_pointcloud_frame_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${math_pi_over_2} -${math_pi_over_2} 0" />
      <parent link="camera_frame" />
      <child link="camera_pointcloud_frame" />
    </joint>
    <link name="camera_pointcloud_frame">
      <inertial>
        <mass value="0.0001" />
        <origin xyz="0 0 0" />
        <inertia ixx="1e-6" ixy="0.0" ixz="0.0"
          iyy="1e-6" iyz="0.0"
          izz="1e-6" />
      </inertial>
    </link>

    <gazebo reference="${prefix}_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <camera>
        <horizontal_fov>1.25</horizontal_fov>
        <image>
          <!-- Match 2D camera resolution to keep CameraInfo consistent -->
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.3</near>
          <far>15</far>
        </clip>
        <optical_frame_id>camera_pointcloud_frame</optical_frame_id>
      </camera>
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <visualize>true</visualize>
      <topic>camera/camera_rgbd</topic>
      <!-- Publish point cloud in the dedicated frame to correct orientation -->
      <gz_frame_id>camera_pointcloud_frame</gz_frame_id>
      <camera_info_topic>camera/camera_rgbd/camera_info</camera_info_topic>
    </sensor>

    </gazebo>
  </xacro:macro>
</robot>